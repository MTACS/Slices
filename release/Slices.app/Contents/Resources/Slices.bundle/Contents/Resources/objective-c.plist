<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>components</key>
    <dict>
        <key>uikit</key>
        <dict>
            <key>displayName</key>
            <string>UIKit</string>
            <key>regex</key>
            <string>\b(UI|_UI)[\w-]+</string>
        </dict>
        <key>logos</key>
        <dict>
            <key>regex</key>
            <string>\b/^(%])[-+]?\w+</string>
            <key>displayName</key>
            <string>Logos</string>
        </dict>
        <key>foundation</key>
        <dict>
            <key>regex</key>
            <string>\bNS[\w-]+</string>
            <key>displayName</key>
            <string>Foundation</string>
        </dict>
        <key>literals</key>
        <dict>
            <key>regex</key>
            <string>\b(false|true|FALSE|TRUE|nil|YES|NO|NULL)\b</string>
            <key>displayName</key>
            <string>Literals</string>
        </dict>
        <key>builtin</key>
        <dict>
            <key>regex</key>
            <string>\b(_Bool|BOOL|dispatch_once_t|dispatch_queue_t|dispatch_sync|dispatch_async|dispatch_once)\b</string>
            <key>displayName</key>
            <string>Built In</string>
        </dict>
        <key>keywords</key>
        <dict>
            <key>regex</key>
            <string>\b(int|float|while|char|export|sizeof|typedef|const|for|union|unsigned|long|volatile|static|bool|mutable|if|do|return|goto|void|enum|else|break|extern|asm|case|short|default|double|register|explicit|signed|typename|this|switch|continue|wchar_t|inline|readonly|assign|readwrite|self|@synchronized|typeof|nonatomic|super|unichar|IBOutlet|IBAction|strong|weak|copy|out|inout|__strong|__weak|__block|__autoreleasing|@interface|@implementation|@private|@protected|@public|@try|@SDK:|@property|@end|@throw|@catch|@finally|@autoreleasepool|@synthesize|@dynamic|@selector|@optional|@required|@encode|@package|@import|@defs|@compatibility_alias|__bridge|__bridge_transfer|__bridge_retained|__bridge_retain|__kindof|_Nonnull|_Nullable|_Null_unspecified|__FUNCTION__|__PRETTY_FUNCTION__|__attribute__|getter|setter|retain|unsafe_unretained|nonnull|nullable|null_unspecified|null_resettable|instancetype|NS_INLINE|NS_AVAILABLE|NS_DEPRECATED|NS_ENUM NS_OPTIONS|NS_ASSUME_NONNULL_BEGIN|NS_ASSUME_NONNULL_END)\b</string>
            <key>displayName</key>
            <string>Keywords</string>
        </dict>
        <key>preprocessors</key>
        <dict>
            <key>regex</key>
            <string>@.*?\w+|\b(id)\b</string>
            <key>displayName</key>
            <string>Preprocessors</string>
        </dict>
        <key>imports</key>
        <dict>
            <key>regex</key>
            <string>#.*?\w+</string>
            <key>displayName</key>
            <string>Imports</string>
        </dict>
        <key>urls</key>
        <dict>
            <key>regex</key>
            <string>((https?|mailto|ftp|file)://([-\w\.]+)+(:\d+)?(/([\w/_\.]*(\?\S+)?)?)?)|\b[^)]_[\w-]+\;</string>
            <key>displayName</key>
            <string>URLs</string>
        </dict>
        <key>brackets</key>
        <dict>
            <key>regex</key>
            <string>(\}|\{)</string>
            <key>displayName</key>
            <string>Brackets</string>
        </dict>
        <key>braces</key>
        <dict>
            <key>regex</key>
            <string>(\(|\))</string>
            <key>displayName</key>
            <string>Braces</string>
        </dict>
        <key>classes</key>
        <dict>
            <key>regex</key>
            <string>\b(_SB|_SBH|SP|SB|SD|BB|BN|BC|CPS|IM|AV|CA|CF|CS|CG|CI|CL|CM|CN|CT|MK|MP|MTK|MTL|SCN|SK|NC|WG|PTS|BKS|PG|SS|VS|WK|XC|XB|RS|FB|Sp|TI|TD|TT|TU|TS|TN)\w+</string>
            <key>displayName</key>
            <string>Classes</string>
        </dict>
        <key>attributes</key>
        <dict>
            <key>regex</key>
            <string>(.+\.[^\d|cxx]\w+)</string>
            <key>displayName</key>
            <string>Attributes</string>
        </dict>
        <key>numbers</key>
        <dict>
            <key>regex</key>
            <string>\b(0x[0-9A-F]+|[0-9]+)\b</string>
            <key>displayName</key>
            <string>Numbers</string>
        </dict>
        <key>characters</key>
        <dict>
            <key>regex</key>
            <string>(\&apos;.\&apos;)</string>
            <key>displayName</key>
            <string>Characters</string>
        </dict>
        <key>strings</key>
        <dict>
            <key>regex</key>
            <string>&lt;[^&gt;]+&gt;|(@?&quot;(?:[^\&quot;\\]|\\.)*&quot;)</string>
            <key>displayName</key>
            <string>Strings</string>
        </dict>
        <key>comments</key>
        <dict>
            <key>regex</key>
            <string>\/\/[^\&quot;\n\r]*(?:&quot;[^&quot;\n\r]*&quot;[^&quot;\n\r]*)*[\r\n]</string>
            <key>displayName</key>
            <string>Comments</string>
        </dict>
        <key>documentation_markup</key>
        <dict>
            <key>regex</key>
            <string>\/\*(.*?|\n)+\*\/</string>
            <key>group</key>
            <integer>1</integer>
            <key>displayName</key>
            <string>Documentation</string>
        </dict>
        <key>documentation_markup_keywords</key>
        <dict>
            <key>regex</key>
            <string>(\/\*|\*\/)</string>
            <key>displayName</key>
            <string>Documentation Keywords</string>
        </dict>
    </dict>
    <key>extensions</key>
    <array>
        <string>m</string>
        <string>mm</string>
        <string>xm</string>
        <string>h</string>
    </array>
</dict>
</plist>
